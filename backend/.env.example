PORT=3002
# Ejemplo de Neon con pooler (usa la URL real que te dio Neon, sin comillas):
DATABASE_URL=postgres://usuario:contraseña@ep-xxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
WEB_ORIGIN=http://127.0.0.1:5173
# En producción, usa el dominio de tu frontend (Vercel o Cloud Run):
# WEB_ORIGIN=https://tu-frontend.vercel.app
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
SMS_PROVIDER=sandbox
# Para envío real de SMS (ej. Twilio), descomenta y configura en tu entorno:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
# TWILIO_FROM_NUMBER=+15005550006
# OTP_SECRET=replace-with-a-random-secret-for-otp-signing
